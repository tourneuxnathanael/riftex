{
  "name": "riftex",
  "version": "0.1.0",
  "private": true,
  "description": "Générateur automatique de vidéos verticales (TikTok/Shorts) : script LLM, voix off, visuels, sous-titres animés, publication TikTok.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "tsx src/cli/generate.ts",
    "tiktok:auth": "tsx src/cli/tiktok-auth.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "dotenv": "^16.4.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
