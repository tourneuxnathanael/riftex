# ---------- Scripting (Anthropic) ----------
ANTHROPIC_API_KEY=
# Modèle principal (défaut : claude-opus-5). Mettre claude-sonnet-5 pour réduire les coûts.
ANTHROPIC_MODEL=claude-opus-5
# Modèle de repli si le modèle principal refuse la requête (stop_reason = "refusal").
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8

# ---------- Voix off (ElevenLabs) ----------
ELEVENLABS_API_KEY=
# ID de voix ElevenLabs (Voice Library > "Copy voice ID")
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------- Visuels ----------
# pexels | openai | mock
VISUAL_PROVIDER=pexels
PEXELS_API_KEY=
# Option B (génération d'images) : OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------- Rendu ----------
# Musique de fond libre de droits (mp3/wav), optionnelle
BACKGROUND_MUSIC_PATH=
MUSIC_VOLUME=0.18
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# ultrafast | veryfast | medium | slow
X264_PRESET=veryfast
OUTPUT_DIR=./output

# ---------- TikTok Content Posting API ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Doit être enregistré à l'identique dans le portail développeur TikTok
TIKTOK_REDIRECT_URI=http://localhost:3456/tiktok/callback
# Fichier où sont stockés les tokens OAuth après `npm run tiktok:auth`
TIKTOK_TOKEN_PATH=./.data/tiktok-token.json
