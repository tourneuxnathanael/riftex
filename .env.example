# --- Obligatoires ---
# Clé API Anthropic (seul coût du pipeline : les tokens du LLM)
ANTHROPIC_API_KEY=
# Clé API Pexels gratuite : https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Optionnels ---
# Modèle Claude (défaut : claude-opus-5 ; claude-sonnet-5 coûte ~2,5x moins cher)
ANTHROPIC_MODEL=claude-opus-5
# Voix edge-tts et débit (+5% à +10% pour un rythme story-time)
TTS_VOICE=fr-FR-HenriNeural
TTS_RATE=+8%
# Modèle faster-whisper : tiny | base | small | medium | large-v3 (small = bon compromis CPU)
WHISPER_MODEL=small
# cpu | cuda | auto
WHISPER_DEVICE=auto
# Musique de fond libre de droits (mp3/wav), mixée à ~15 %
BACKGROUND_MUSIC=
MUSIC_VOLUME=0.15
# ultrafast | veryfast | medium (qualité/temps de rendu)
X264_PRESET=veryfast
